<root BTCPP_format="4" main_tree_to_execute="Lap">
  <BehaviorTree ID="Lap">
    <PipelineSequence>
      <RateController hz="1.0">
        <Sequence>
          <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.50"/>
          <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
        </Sequence>
      </RateController>
      <FollowPath path="{path}" controller_id="FollowPath"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
