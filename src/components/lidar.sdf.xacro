<?xml version="1.0" encoding="UTF-8"?>
<sdf xmlns:xacro="http://www.ros.org/wiki/xacro" version="1.8">
  <!-- Hokuyo UST-10LX LiDAR: joint, model, collision, inertia, scan sensor. -->
  <xacro:macro name="lidar" params="">
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
      <pose relative_to="base_link">${lidar_x} 0.0 ${lidar_scan_height - (wheel_radius+wheel_zoff)} 0 0 0</pose>
    </joint>
    <link name="lidar_link">
      <pose relative_to="lidar_joint"/>
      <visual name="lidar_link_visual">
        <pose>0 0 -0.020 0 0 0</pose>
        <material>
          <ambient>0.20 0.23 0.26 1</ambient>
          <diffuse>0.30 0.33 0.36 1</diffuse>
        </material>
        <geometry>
          <mesh>
            <uri>file://$(find ecd726_description)/meshes/hokuyo_ust_10lx.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      <visual name="lidar_front_window">
        <pose>0.0255 0 0.001 0 0 0</pose>
        <geometry>
          <box>
            <size>0.002 0.046 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.015 0.060 0.080 1</ambient>
          <diffuse>0.02 0.13 0.17 1</diffuse>
        </material>
      </visual>
      <collision name="lidar_link_collision">
        <pose>0 0 -0.020 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.07</size>
          </box>
        </geometry>
      </collision>
      <xacro:box_inertia m="0.125" w="0.05" d="0.05" h="0.07"/>
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <topic>scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>1081</samples>
              <resolution>1.000000</resolution>
              <min_angle>-2.356194</min_angle>
              <max_angle>2.356194</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.06</min>
            <max>10.0</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>
    </link>
  </xacro:macro>
</sdf>