<?xml version="1.0" encoding="UTF-8"?>
<sdf xmlns:xacro="http://www.ros.org/wiki/xacro" version="1.8">
  <!-- Intel RealSense D435i: joint, mesh, collision, color and depth sensors. -->
  <xacro:macro name="d435i" params="">
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">${camera_x} 0 ${camera_height - (wheel_radius+wheel_zoff)} 0 0 0</pose>
    </joint>
    <link name="camera_link">
      <pose relative_to="camera_joint"/>
      <visual name="camera_link_visual">
        <pose>0.0149 -0.0175 0 ${pi/2} 0 ${pi/2}</pose>
        <geometry>
          <mesh>
            <uri>file://$(find ecd726_description)/meshes/realsense_d435.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.13 0.15 0.17 1</ambient>
          <diffuse>0.19 0.21 0.23 1</diffuse>
        </material>
      </visual>
      <collision name="camera_link_collision">
        <geometry>
          <box>
            <size>0.025 0.090 0.025</size>
          </box>
        </geometry>
      </collision>
      <xacro:box_inertia m="0.035" w="0.090" d="0.025" h="0.025"/>
      <sensor name="d435i_depth" type="depth_camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <topic>/d435i/depth/image_raw</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <camera name="d435i_depth_camera">
          <camera_info_topic>/d435i/depth/camera_info</camera_info_topic>
          <horizontal_fov>1.48702</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.175</near>
            <far>3.0</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="d435i_color" type="camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <topic>/d435i/color/image_raw</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <camera name="d435i_rgb_camera">
          <camera_info_topic>/d435i/color/camera_info</camera_info_topic>
          <horizontal_fov>1.211</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </link>
  </xacro:macro>
</sdf>