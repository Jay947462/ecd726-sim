<?xml version="1.0" encoding="UTF-8"?>
<sdf xmlns:xacro="http://www.ros.org/wiki/xacro" version="1.8">
  <!-- Wheel and steering macros retain original joint geometry. -->
    <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
      <link name="${prefix}_link">
        <pose relative_to="base_link">${x_reflect*wheel_xoff} ${y_reflect*(base_width/2+wheel_ygap)} ${-wheel_zoff} 0 0 0</pose>
        <visual name="${prefix}_link_visual">
          <pose relative_to="${prefix}_link">0 ${y_reflect*wheel_visual_y_offset} 0 ${pi/2} 0 0</pose>
          <geometry>
            <cylinder>
              <radius>${wheel_radius}</radius>
              <length>${wheel_width}</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.035 0.038 0.040 1.0</ambient>
            <diffuse>0.055 0.058 0.061 1.0</diffuse>
          </material>
        </visual>
        <visual name="${prefix}_outer_hub_visual">
          <pose>0 ${y_reflect*(wheel_visual_y_offset + wheel_width/2 + 0.001)} 0 ${pi/2} 0 0</pose>
          <geometry>
            <cylinder>
              <radius>${wheel_radius*0.46}</radius>
              <length>0.003</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.34 0.37 0.40 1</ambient>
            <diffuse>0.50 0.53 0.56 1</diffuse>
          </material>
        </visual>
        <collision name="${prefix}_link_collision">
          <pose relative_to="${prefix}_link">0 0 0 ${pi/2} 0 0</pose>
          <geometry>
            <cylinder>
              <radius>${wheel_radius}</radius>
              <length>${wheel_width}</length>
            </cylinder>
          </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="${wheel_width}"/>
      </link>
      <joint name="${prefix}_joint" type="revolute">
        <parent>base_link</parent>
        <child>${prefix}_link</child>
        <pose relative_to="base_link">${x_reflect*wheel_xoff} ${y_reflect*(base_width/2+wheel_ygap)} ${-wheel_zoff} 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>
    </xacro:macro>
    <xacro:macro name="steer_wheel" params="prefix y_reflect">
      <link name="${prefix}_steer_link">
        <pose relative_to="base_link">${wheel_xoff} ${y_reflect*(base_width/2+wheel_ygap)} ${-wheel_zoff} 0 0 0</pose>
        <xacro:cylinder_inertia m="0.1" r="0.02" h="0.02"/>
      </link>
      <joint name="${prefix}_steer_joint" type="revolute">
        <parent>base_link</parent>
        <child>${prefix}_steer_link</child>
        <pose relative_to="base_link">${wheel_xoff} ${y_reflect*(base_width/2+wheel_ygap)} ${-wheel_zoff} 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>${-max_steer}</lower>
            <upper>${max_steer}</upper>
          </limit>
        </axis>
      </joint>
      <link name="${prefix}_link">
        <pose relative_to="${prefix}_steer_link">0 0 0 0 0 0</pose>
        <visual name="${prefix}_link_visual">
          <pose relative_to="${prefix}_link">0 ${y_reflect*wheel_visual_y_offset} 0 ${pi/2} 0 0</pose>
          <geometry>
            <cylinder>
              <radius>${wheel_radius}</radius>
              <length>${wheel_width}</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.035 0.038 0.040 1.0</ambient>
            <diffuse>0.055 0.058 0.061 1.0</diffuse>
          </material>
        </visual>
        <visual name="${prefix}_outer_hub_visual">
          <pose>0 ${y_reflect*(wheel_visual_y_offset + wheel_width/2 + 0.001)} 0 ${pi/2} 0 0</pose>
          <geometry>
            <cylinder>
              <radius>${wheel_radius*0.46}</radius>
              <length>0.003</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.34 0.37 0.40 1</ambient>
            <diffuse>0.50 0.53 0.56 1</diffuse>
          </material>
        </visual>
        <collision name="${prefix}_link_collision">
          <pose relative_to="${prefix}_link">0 0 0 ${pi/2} 0 0</pose>
          <geometry>
            <cylinder>
              <radius>${wheel_radius}</radius>
              <length>${wheel_width}</length>
            </cylinder>
          </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="${wheel_width}"/>
      </link>
      <joint name="${prefix}_joint" type="revolute">
        <parent>${prefix}_steer_link</parent>
        <child>${prefix}_link</child>
        <pose relative_to="${prefix}_steer_link">0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>
    </xacro:macro>
  <xacro:macro name="wheels" params="">
    <xacro:wheel prefix="drivewhl_l" x_reflect="-1" y_reflect="1"/>
    <xacro:wheel prefix="drivewhl_r" x_reflect="-1" y_reflect="-1"/>
    <xacro:steer_wheel prefix="steer_l" y_reflect="1"/>
    <xacro:steer_wheel prefix="steer_r" y_reflect="-1"/>
    <!-- Restored Gazebo Harmonic vehicle control and joint-state plugins -->
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>drivewhl_l_joint</left_joint>
      <right_joint>drivewhl_r_joint</right_joint>
      <left_steering_joint>steer_l_steer_joint</left_steering_joint>
      <right_steering_joint>steer_r_steer_joint</right_steering_joint>
      <kingpin_width>${base_width + 2*wheel_ygap}</kingpin_width>
      <steering_limit>${max_steer}</steering_limit>
      <steer_p_gain>${rover_sim.steering_position_gain}</steer_p_gain>
      <wheel_base>${2*wheel_xoff}</wheel_base>
      <wheel_separation>${base_width + 2*wheel_ygap}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <min_velocity>-10.0</min_velocity>
      <max_velocity>10.0</max_velocity>
      <min_acceleration>-3.0</min_acceleration>
      <max_acceleration>3.0</max_acceleration>
      <topic>/demo/cmd_vel</topic>
      <odom_topic>/demo/odom</odom_topic>
      <tf_topic>/demo/gz_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>rear_axle</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </xacro:macro>
</sdf>