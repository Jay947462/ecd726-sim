<?xml version="1.0" encoding="UTF-8"?>
<sdf xmlns:xacro="http://www.ros.org/wiki/xacro" version="1.8">
  <!-- Shared measured/estimated geometry and mounting positions (meters). -->
    <xacro:property name="base_width" value="0.1778"/>
    <xacro:property name="base_length" value="0.485775"/>
    <xacro:property name="base_height" value="0.035"/>
    <xacro:property name="wheel_radius" value="0.0523875"/>
    <xacro:property name="wheel_width" value="0.041275"/>
    <xacro:property name="wheel_ygap" value="0.03413125"/>
    <!-- Match the published span at the rendered tire sidewalls. -->
    <xacro:property name="tire_visual_span" value="0.296"/>
    <xacro:property name="wheel_visual_y_offset" value="${(tire_visual_span - base_width - 2*wheel_ygap - wheel_width)/2}"/>
    <xacro:property name="wheel_zoff" value="0.0413125"/>
    <xacro:property name="wheel_xoff" value="${rover_sim.wheelbase_m / 2}"/>
    <xacro:property name="vehicle_length" value="0.5461"/>
    <xacro:property name="lidar_x" value="0.1762125"/>
    <xacro:property name="lidar_scan_height" value="0.1755"/>
    <xacro:property name="lidar_mount_z" value="${lidar_scan_height - (wheel_radius+wheel_zoff)}"/>
    <xacro:property name="lidar_body_center_z" value="-0.020"/>
    <xacro:property name="lidar_body_height" value="0.07"/>
    <xacro:property name="lower_deck_length" value="0.381"/>
    <xacro:property name="lower_deck_width" value="0.1778"/>
    <xacro:property name="upper_deck_length" value="0.3302"/>
    <xacro:property name="upper_deck_width" value="0.1397"/>
    <xacro:property name="deck_thickness" value="0.0049022"/>
    <!-- The kit uses two-inch standoffs. Seat the stack below the Hokuyo scan plane. -->
    <xacro:property name="deck_standoff_length" value="0.0508"/>
    <xacro:property name="lower_deck_z" value="0.0218"/>
    <xacro:property name="upper_deck_z" value="${lower_deck_z + deck_thickness + deck_standoff_length}"/>
    <xacro:property name="upper_deck_x" value="-0.014"/>
    <xacro:property name="upper_deck_top" value="${upper_deck_z + deck_thickness/2}"/>
    <!-- Retain the photo-based camera pose and fit the post to the upper deck. -->
    <xacro:property name="camera_x" value="0.135"/>
    <xacro:property name="camera_body_height" value="0.025"/>
    <xacro:property name="camera_tab_thickness" value="0.005"/>
    <xacro:property name="camera_mount_z" value="0.1162511"/>
    <xacro:property name="camera_tab_top" value="${upper_deck_top + camera_tab_thickness}"/>
    <xacro:property name="camera_post_height" value="${camera_mount_z - camera_body_height/2 - camera_tab_top}"/>
  <xacro:property name="max_steer" value="0.6"/>

  <!-- Shared inertial macros. -->
    <xacro:macro name="box_inertia" params="m w h d">
      <inertial>
        <pose>0 0 0 ${pi/2} 0 ${pi/2}</pose>
        <mass>${m}</mass>
        <inertia>
          <ixx>${(m/12) * (h*h + d*d)}</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>${(m/12) * (w*w + d*d)}</iyy>
          <iyz>0.0</iyz>
          <izz>${(m/12) * (w*w + h*h)}</izz>
        </inertia>
      </inertial>
    </xacro:macro>
    <xacro:macro name="cylinder_inertia" params="m r h">
      <inertial>
        <pose>0 0 0 ${pi/2} 0 0</pose>
        <mass>${m}</mass>
        <inertia>
          <ixx>${(m/12) * (3*r*r + h*h)}</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>${(m/12) * (3*r*r + h*h)}</iyy>
          <iyz>0.0</iyz>
          <izz>${(m/2) * (r*r)}</izz>
        </inertia>
      </inertial>
    </xacro:macro>
    <xacro:macro name="sphere_inertia" params="m r">
      <inertial>
        <mass>${m}</mass>
        <inertia>
          <ixx>${(2/5) * m * (r*r)}</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>${(2/5) * m * (r*r)}</iyy>
          <iyz>0.0</iyz>
          <izz>${(2/5) * m * (r*r)}</izz>
        </inertia>
      </inertial>
    </xacro:macro>
</sdf>